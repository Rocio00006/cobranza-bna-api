            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('CONFIRMADO', () => pm.expect(j.estado).to.eql('CONFIRMADO'));",
                  "pm.test('saldo baja a 850', () => pm.expect(j.aplicacion.saldoPendienteCuota).to.eql(850));"
                ]
              }
            }
          ],
          "request": {

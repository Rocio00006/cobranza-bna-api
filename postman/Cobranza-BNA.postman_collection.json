{
  "info": {
    "_postman_id": "88df6e07-ef19-44a3-9d02-c4019aa492d0",
    "name": "Cobranza BNA",
    "description": "Coleccion de pruebas de la API de Cobranza (Linea de Creditos, BNA). Organizada por interfaz, en el mismo orden que el guion del video del README. Cada request cita la RF/RN que demuestra en su descripcion y trae al menos un test que verifica el codigo HTTP y un campo clave de la respuesta. Pensada para correr contra una instancia standalone de Cobranza (CUENTAS_URL vacio, Cuentas simulado en memoria).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CR-INT-06 (Desembolso -> Cobranza)",
      "item": [
        {
          "name": "1. Activar obligacion (RN-COB-001, RF-COB-001)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = Date.now();",
                  "pm.environment.set('codCredito', 'CR-PM-' + t);",
                  "pm.environment.set('idCliente', 'CLI-PM-' + t);",
                  "pm.environment.set('idSolicitud', 'SOL-PM-' + t);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('estadoCredito AL_DIA', () => pm.expect(j.estadoCredito).to.eql('AL_DIA'));",
                  "pm.test('tiene 1 cuota PENDIENTE', () => pm.expect(j.cuotas[0].estadoCuota).to.eql('PENDIENTE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKeyBus}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cr-int-06/obligaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cr-int-06",
                "obligaciones"
              ]
            },
            "description": "CR-INT-06: Desembolso activa el credito y entrega su calendario de cuotas. Requiere rol INTEGRACION_BUS. Demuestra RF-COB-001 / RN-COB-001.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codCredito\": \"{{codCredito}}\",\n  \"idCliente\": \"{{idCliente}}\",\n  \"idSolicitud\": \"{{idSolicitud}}\",\n  \"montoAprobado\": 1000.0,\n  \"moneda\": \"PEN\",\n  \"fechaDesembolso\": \"2026-10-05T10:00:00\",\n  \"calendarioPagos\": [\n    {\n      \"numeroCuota\": 1,\n      \"fechaVencimiento\": \"2026-11-05\",\n      \"montoCuota\": 1000.0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "2. Duplicado: credito ya activado (RN-COB-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('regla RN-COB-001', () => pm.expect(pm.response.json().regla).to.eql('RN-COB-001'));"
                ]

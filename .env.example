# Copia este archivo como .env y ajusta tus datos de MySQL.
# Si la clave tiene caracteres especiales (@ : / #), codificalos (por ejemplo @ = %40).
# Usa 127.0.0.1, no "localhost": en Windows, resolver "localhost" puede sumar ~1s por conexion
# (intenta IPv6 primero y falla antes de caer a IPv4). Con 127.0.0.1 esa espera desaparece.
DATABASE_URL=mysql://root:TU_CLAVE@127.0.0.1:3306/cobranza_bna
# Vacio = Cuentas SIMULADO (en memoria, dentro del mismo proceso). Con una URL, Cobranza llama a
# Cuentas por HTTP (CR-INT-07), SIEMPRE a traves del Bus de Servicios (RNF-04), nunca directo:
# Parte 3, simuladores/bus_app.py enruta /cuentas/* al simulador HTTP de Cuentas (simuladores/cuentas_app.py).
# Para la prueba de integracion completa (levantar_todo.bat ya la define):
# CUENTAS_URL=http://127.0.0.1:8090/cuentas/cargos
CUENTAS_URL=

# Roles (I-04), autenticacion simple por header X-API-Key. Valores de ejemplo FICTICIOS: genera las
# tuyas (nunca las subas al repositorio; .env ya esta en .gitignore).
API_KEY_COBRANZA_LEER=dev-leer-CAMBIAME
API_KEY_COBRANZA_EJECUTAR=dev-ejecutar-CAMBIAME
API_KEY_INTEGRACION_BUS=dev-bus-CAMBIAME

# RF-COB-004 (PROPUESTA pendiente del Comite): bloqueo temporal tras rechazos seguidos de
# X-Token-Seguridad para el mismo cliente, en CR-INT-08.
SEGURIDAD_BLOQUEO_SEGUNDOS=300
SEGURIDAD_LIMITE_RECHAZOS=3

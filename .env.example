# Copia este archivo como .env y ajusta tus datos de MySQL.
# Si la clave tiene caracteres especiales (@ : / #), codificalos (por ejemplo @ = %40).
DATABASE_URL=mysql://root:TU_CLAVE@localhost:3306/cobranza_bna
# Vacio = Cuentas SIMULADO. Con una URL, se llama al modulo Cuentas real (CR-INT-07).
CUENTAS_URL=

# Roles (I-04), autenticacion simple por header X-API-Key. Valores de ejemplo FICTICIOS: genera las
# tuyas (nunca las subas al repositorio; .env ya esta en .gitignore).
API_KEY_COBRANZA_LEER=dev-leer-CAMBIAME
API_KEY_COBRANZA_EJECUTAR=dev-ejecutar-CAMBIAME
API_KEY_INTEGRACION_BUS=dev-bus-CAMBIAME

# RF-COB-004 (PROPUESTA pendiente del Comite): bloqueo temporal tras rechazos seguidos de
# X-Token-Seguridad para el mismo cliente, en CR-INT-08.
SEGURIDAD_BLOQUEO_SEGUNDOS=300
SEGURIDAD_LIMITE_RECHAZOS=3
